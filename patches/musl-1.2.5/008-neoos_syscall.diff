+    case LX_SCHED_GETAFFINITY: return neo(NEO_SCHED_GETAFFINITY, a1, a2, a3, 0, 0, 0);
+    case LX_MEMBARRIER:        return neo(NEO_MEMBARRIER, a1, a2, 0, 0, 0, 0);
