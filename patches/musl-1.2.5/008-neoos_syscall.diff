+    case LX_LSTAT:
+        return neo(NEO_LSTAT, a1, neo_strlen((const char *)a1), a2, 0, 0, 0);
+    case LX_MKDIR:
+        return neo(NEO_MKDIR, a1, neo_strlen((const char *)a1), 0, 0, 0, 0);
+    case LX_UNLINK:
+        return neo(NEO_UNLINK, a1, neo_strlen((const char *)a1), 0, 0, 0, 0);
